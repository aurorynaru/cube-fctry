{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-factory.local/art/schemas/style-profile.schema.json",
  "title": "Roblox Factory style profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "genres", "audience", "camera", "devices", "pillars", "identity", "palette", "geometry", "materials", "lighting", "effects", "ui", "audio", "budgets", "originality"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "$ref": "#/$defs/text" },
    "genres": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "audience": { "$ref": "#/$defs/text" },
    "camera": { "$ref": "#/$defs/text" },
    "devices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["phone", "tablet", "desktop", "console"] } },
    "pillars": { "type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "identity": { "$ref": "#/$defs/text" },
    "palette": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "accent", "semantic", "rule"],
      "properties": {
        "base": { "$ref": "#/$defs/colors" }, "accent": { "$ref": "#/$defs/colors" },
        "semantic": {
          "type": "object", "additionalProperties": false,
          "required": ["interactable", "hazard", "reward", "neutral"],
          "properties": {
            "interactable": { "$ref": "#/$defs/color" }, "hazard": { "$ref": "#/$defs/color" },
            "reward": { "$ref": "#/$defs/color" }, "neutral": { "$ref": "#/$defs/color" }
          }
        },
        "rule": { "$ref": "#/$defs/text" }
      }
    },
    "geometry": { "$ref": "#/$defs/text" },
    "materials": {
      "type": "object", "additionalProperties": false, "required": ["surfaces", "texture_rule", "tiling_rule"],
      "properties": { "surfaces": { "$ref": "#/$defs/text" }, "texture_rule": { "$ref": "#/$defs/text" }, "tiling_rule": { "$ref": "#/$defs/text" } }
    },
    "lighting": { "$ref": "#/$defs/text" }, "effects": { "$ref": "#/$defs/text" },
    "ui": { "$ref": "#/$defs/text" }, "audio": { "$ref": "#/$defs/text" },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["target_fps_phone", "max_texture_edge_px", "max_texture_bytes", "reuse_rule"],
      "properties": {
        "target_fps_phone": { "type": "integer", "minimum": 30, "maximum": 120 },
        "max_texture_edge_px": { "type": "integer", "minimum": 128, "maximum": 4096 },
        "max_texture_bytes": { "type": "integer", "minimum": 1 },
        "reuse_rule": { "$ref": "#/$defs/text" }
      }
    },
    "originality": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "colors": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/color" } }
  }
}
