# Roblox Open Cloud target for tool/publish.sh.
# These ids are not secrets — the API key is, and never lives here.
# Find them in the Creator Dashboard URL for the experience:
#   .../dashboard/creations/experiences/<UNIVERSE_ID>/places/<PLACE_ID>/configure
#
# Leave UNIVERSE_ID/PLACE_ID at 0 until this game has an experience. CI will
# refuse to upload until they are set.
UNIVERSE_ID=0
PLACE_ID=0
PLACE_FILE=build/place.rbxl
# PLACE_NAME=my-game   # optional macOS Keychain account (then falls back to default)
